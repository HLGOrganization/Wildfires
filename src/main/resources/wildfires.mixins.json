{
  "required": true,
  "minVersion": "0.8",
  "package": "first.wildfires.mixin",
  "compatibilityLevel": "JAVA_17",
  "refmap": "wildfires.refmap.json",
  "mixins": [
    "aquaculture.FishDataMixin",
    "alex.GuanoLayerBlockMixin",
    "create.AllGuiTexturesAccessor",
    "create.AllGuiTexturesMixin",
    "create.AttributeFilterItemStackMixin",
    "create.AttributeFilterMenuAccessor",
