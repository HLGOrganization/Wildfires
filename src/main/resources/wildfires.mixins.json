    "tfc.TFCChestBlockEntityMixin",
    /*
     * Disabled 2026-10-01 - the eighth charcoal forge heat tier moved into the
     * rebuilt woodencog_wildfire mod itself:
     *
     *   tfc.TFCBlockStatePropertiesMixin - relocated.
     *       It raised TFC's shared heat_level property maximum from 7 to 8 so that
     *       the earthen oven's heat_level=8 block state variants would resolve.
     *       That property can only have one owner. woodencog_wildfire now extends it
     *       itself (net.chauvedev.woodencog.mixin.heat.MixinTFCBlockStateProperties)
     *       and promotes a forge to tier 8 at 2300C
     *       (net.chauvedev.woodencog.mixin.heat.MixinCharcoalForgeBlockEntity).
     *       Keeping this entry as well would install a second redirect on the very
     *       same IntegerProperty.create call site and a second writer of the same
     *       block state. The earthen oven reaches tier 8 through the woodencog
     *       property now; the class is kept in the source tree for the case that
     *       Wildfires has to run without woodencog_wildfire again.
     *
     * To re-enable it, move the entry back into the array below - but only after
     * removing the two woodencog mixins named above.
     */
    // "tfc.TFCBlockStatePropertiesMixin",
    "tfc.ExtendedFluidTypeMixin",
    "tfc.InventoryBlockEntityAccessor",
    "tfc.ItemTypeMixin",
    "tfc.ForgeEventHandlerCelestialMixin",
    "tfc.ServerCalendarRateMixin",
    "tfc.PanItemMixin",
    "tfc.PredatorMixin",
    "tfc.SluiceBlockEntityMixin",
    "tfc.ToolItemMixin"
  ],
